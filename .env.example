# Local port for the proxy server
A2O_PROXY_PORT=3456

# OpenAI-compatible endpoint (no trailing slash)
A2O_OPENAI_BASE_URL=https://api.openai.com/v1

# API key for the OpenAI endpoint
A2O_OPENAI_API_KEY=sk-...

# Model to use at the OpenAI endpoint
A2O_OPENAI_MODEL=gpt-4.1

# Optional mapping from Anthropic model names to OpenAI models (JSON string)
# Example: A2O_MODEL_MAP='{"claude-3-5-sonnet-20241022":"gpt-4o-mini"}'
A2O_MODEL_MAP=

# Network interface to bind. Loopback by default (proxy has no client auth and
# uses the server-side key for every request). Set 0.0.0.0 to expose it.
A2O_BIND_HOST=127.0.0.1

# Abort the upstream request after this many ms (0 disables the timeout)
A2O_UPSTREAM_TIMEOUT_MS=600000

# Opt-in verbose logging to stdout (both write conversation content). Leave unset to disable.
# A2O_DEBUG_REQUESTS=1
# A2O_DEBUG_SSE=1
