{
  "name": "anthropic2openai",
  "version": "1.0.0",
  "description": "Proxy that translates Anthropic Messages API requests to OpenAI Chat Completions API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "json",
      "html-spa",
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 75,
        "functions": 80,
        "lines": 85
      }
    }
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/jest-runner": "^9.6.0",
    "jest": "^30.1.3",
    "jest-fetch-mock": "^3.0.3",
    "supertest": "^7.1.4"
  }
}
